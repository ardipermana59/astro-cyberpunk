<svg xmlns="http://www.w3.org/2000/svg" width="512" height="512" viewBox="0 0 512 512">
  <defs>
    <linearGradient id="iconGrad512" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#00fff0;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#ff00ff;stop-opacity:1" />
    </linearGradient>
  </defs>

  <!-- Background -->
  <rect width="512" height="512" fill="#0a0f1c" rx="64"/>

  <!-- Border -->
  <rect x="32" y="32" width="448" height="448" fill="none" stroke="url(#iconGrad512)" stroke-width="6" rx="48"/>

  <!-- Initials -->
  <text x="256" y="330" font-family="Orbitron, sans-serif" font-size="220" font-weight="bold" fill="url(#iconGrad512)" text-anchor="middle">
    AP
  </text>

  <!-- Glow effect -->
  <circle cx="256" cy="256" r="180" fill="none" stroke="url(#iconGrad512)" stroke-width="4" opacity="0.3"/>
  <circle cx="256" cy="256" r="150" fill="none" stroke="url(#iconGrad512)" stroke-width="2" opacity="0.2"/>
</svg>
