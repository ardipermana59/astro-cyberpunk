---
import type { PortfolioProject } from '../utils/content';

interface Props {
  project: PortfolioProject;
  index?: number;
}

const { project, index = 0 } = Astro.props;
---

<a
  href={`/portfolio/${project.slug}`}
  class="group block h-full"
  data-aos="fade-up"
  data-aos-delay={index * 100}
>
  <div class="relative h-full rounded-lg overflow-hidden border-2 transition-all duration-300 hover:scale-[1.02] hover:shadow-2xl" style="background: rgba(10, 15, 28, 0.7); backdrop-filter: blur(10px); border-color: rgba(0, 255, 240, 0.2);">
    <!-- Image -->
    <div class="relative h-56 overflow-hidden bg-gradient-to-br from-cyan-900/20 to-purple-900/20">
      <img
        src={project.image}
        alt={project.title}
        class="w-full h-full object-cover transition-all duration-500 group-hover:scale-110 group-hover:rotate-1"
        style="filter: brightness(0.9) contrast(1.1);"
      />
      <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(10, 15, 28, 0.9) 0%, transparent 50%, rgba(10, 15, 28, 0.3) 100%);"></div>

      <!-- Neon border effect on hover -->
      <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-300" style="box-shadow: inset 0 0 30px rgba(0, 255, 240, 0.3);"></div>

      <!-- Tags -->
      <div class="absolute top-4 right-4 flex flex-wrap gap-2">
        {project.tags.slice(0, 2).map((tag) => (
          <span class="px-3 py-1 text-xs font-orbitron backdrop-blur-md border rounded-full" style="background: rgba(0, 255, 240, 0.2); border-color: rgb(0, 255, 240); color: rgb(0, 255, 240);">
            #{tag}
          </span>
        ))}
      </div>

      <!-- Scan line animation -->
      <div class="absolute inset-0 pointer-events-none opacity-20">
        <div class="scan-line"></div>
      </div>
    </div>

    <!-- Content -->
    <div class="p-6">
      <!-- Date -->
      <div class="flex items-center gap-2 mb-3" style="color: rgba(224, 224, 224, 0.6);">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        <time class="text-sm">{new Date(project.date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</time>
      </div>

      <!-- Title -->
      <h3 class="font-orbitron text-xl font-bold mb-3 transition-all group-hover:tracking-wider" style="color: rgb(0, 255, 240); text-shadow: 0 0 10px rgba(0, 255, 240, 0.5);">
        {project.title}
      </h3>

      <!-- Summary -->
      <p class="text-sm mb-6 line-clamp-3 leading-relaxed" style="color: rgba(224, 224, 224, 0.8);">
        {project.summary}
      </p>

      <!-- Links -->
      <div class="flex gap-4 pt-4 border-t" style="border-color: rgba(0, 255, 240, 0.2);">
        {project.demoUrl && (
          <div class="flex items-center gap-2 text-sm font-rajdhani transition-all hover:translate-x-1" style="color: rgb(0, 255, 240);">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
            <span class="font-semibold">Live Demo</span>
          </div>
        )}
        {project.githubUrl && (
          <div class="flex items-center gap-2 text-sm font-rajdhani transition-all hover:translate-x-1" style="color: rgb(0, 255, 240);">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
            </svg>
            <span class="font-semibold">View Code</span>
          </div>
        )}
      </div>
    </div>

    <!-- Corner decorations -->
    <div class="absolute top-0 left-0 w-8 h-8 border-l-2 border-t-2 opacity-50 group-hover:opacity-100 transition-opacity" style="border-color: rgb(0, 255, 240);"></div>
    <div class="absolute bottom-0 right-0 w-8 h-8 border-r-2 border-b-2 opacity-50 group-hover:opacity-100 transition-opacity" style="border-color: rgb(255, 0, 255);"></div>
  </div>
</a>

<style>
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .scan-line {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, rgb(0, 255, 240), transparent);
    animation: scan 3s linear infinite;
  }

  @keyframes scan {
    0% {
      top: 0;
    }
    100% {
      top: 100%;
    }
  }
</style>
