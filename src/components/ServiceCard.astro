---
import DecorativeCorners from './DecorativeCorners.astro';
import GlowEffect from './GlowEffect.astro';

interface Props {
  title: string;
  description: string;
  icon: string;
  iconColor: string;
  bgColor: string;
  borderColor: string;
  glowColor: string;
  delay?: number;
}

const {
  title,
  description,
  icon,
  iconColor,
  bgColor,
  borderColor,
  glowColor,
  delay = 0
} = Astro.props;
---

<div
  class="service-card group relative rounded-lg p-6 backdrop-blur-sm transition-all duration-300 hover:scale-105 text-center"
  style={`background: ${bgColor}; border: 2px solid ${borderColor};`}
  data-aos="fade-up"
  data-aos-delay={delay}
>
  <!-- Glow effect on hover -->
  <GlowEffect color={glowColor} />

  <!-- Icon container -->
  <div class="relative mb-4 flex justify-center">
    <div
      class="icon-container w-20 h-20 rounded-full flex items-center justify-center transition-all duration-300 group-hover:scale-110 group-hover:rotate-12"
      style={`background: ${bgColor}; border: 2px solid ${borderColor}; box-shadow: 0 0 20px ${glowColor}, inset 0 0 20px ${glowColor};`}
    >
      <slot name="icon">
        {icon === 'code' && (
          <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 relative z-10" style={`color: ${iconColor}; filter: drop-shadow(0 0 8px ${iconColor});`} fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
          </svg>
        )}
        {icon === 'shield' && (
          <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 relative z-10" style={`color: ${iconColor}; filter: drop-shadow(0 0 8px ${iconColor});`} fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
        )}
        {icon === 'terminal' && (
          <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 relative z-10" style={`color: ${iconColor}; filter: drop-shadow(0 0 8px ${iconColor});`} fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
        )}
        {icon === 'cube' && (
          <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 relative z-10" style={`color: ${iconColor}; filter: drop-shadow(0 0 8px ${iconColor});`} fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
          </svg>
        )}
      </slot>
    </div>
  </div>

  <!-- Content -->
  <div class="relative">
    <h4
      class="font-orbitron text-lg font-bold mb-3 transition-all duration-300 group-hover:scale-105"
      style={`color: ${iconColor}; text-shadow: 0 0 10px ${glowColor};`}
    >
      {title}
    </h4>
    <p class="text-cyber-text/90 text-sm leading-relaxed">
      {description}
    </p>
  </div>

  <!-- Corner decorations -->
  <DecorativeCorners position="top-left" color={iconColor} />
  <DecorativeCorners position="bottom-right" color={iconColor} />
</div>
