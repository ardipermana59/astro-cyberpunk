---
// Particle background component using tsParticles
---

<div id="tsparticles" class="fixed inset-0 -z-10"></div>

<script>
  import { tsParticles } from "@tsparticles/engine";
  import { loadSlim } from "@tsparticles/slim";

  async function initParticles() {
    await loadSlim(tsParticles);

    await tsParticles.load({
      id: "tsparticles",
      options: {
        background: {
          color: {
            value: "#0a0f1c",
          },
        },
        fpsLimit: 30, // Reduced from 60 for better performance
        particles: {
          number: {
            value: 50, // Reduced from 100 for better performance
            density: {
              enable: true,
            },
          },
          color: {
            value: ["#00fff0", "#ff00ff"],
          },
          shape: {
            type: "circle",
          },
          opacity: {
            value: { min: 0.1, max: 0.5 },
            animation: {
              enable: true,
              speed: 1,
              sync: false,
            },
          },
          size: {
            value: { min: 1, max: 3 },
          },
          links: {
            enable: true,
            distance: 150,
            color: "#00fff0",
            opacity: 0.2,
            width: 1,
          },
          move: {
            enable: true,
            speed: 1,
            direction: "none",
            random: true,
            straight: false,
            outModes: {
              default: "bounce",
            },
          },
        },
        interactivity: {
          events: {
            onHover: {
              enable: true,
              mode: "grab",
            },
            onClick: {
              enable: true,
              mode: "push",
            },
          },
          modes: {
            grab: {
              distance: 140,
              links: {
                opacity: 0.5,
              },
            },
            push: {
              quantity: 4,
            },
          },
        },
        detectRetina: true,
      },
    });
  }

  // Check if particles are enabled from config
  const particlesEnabled = import.meta.env.ENABLE_PARTICLE_EFFECTS !== "false";

  if (particlesEnabled) {
    // Delay particle initialization until after page is fully loaded
    // Use requestIdleCallback for better performance
    if ('requestIdleCallback' in window) {
      requestIdleCallback(() => {
        initParticles();
      }, { timeout: 2000 });
    } else {
      // Fallback for browsers that don't support requestIdleCallback
      setTimeout(() => {
        initParticles();
      }, 1000);
    }
  }
</script>
