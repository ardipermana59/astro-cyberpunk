---
import DecorativeCorners from './DecorativeCorners.astro';

interface Props {
  title: string;
  description?: string;
  icon?: string;
  iconColor?: string;
  bgColor?: string;
  borderColor?: string;
  glowColor?: string;
  cornerPosition?: 'all' | 'top-left' | 'top-right' | 'bottom-left' | 'bottom-right' | 'top' | 'bottom';
  className?: string;
  delay?: number;
}

const {
  title,
  description,
  icon,
  iconColor = '#00fff0',
  bgColor = 'rgba(0, 255, 240, 0.1)',
  borderColor = 'rgba(0, 255, 240, 0.5)',
  glowColor = 'rgba(0, 255, 240, 0.4)',
  cornerPosition = 'top-left',
  className = '',
  delay = 0
} = Astro.props;
---

<div
  class={`group relative rounded-lg p-6 backdrop-blur-sm transition-all duration-300 hover:scale-105 ${className}`}
  style={`background: ${bgColor}; border: 2px solid ${borderColor};`}
  data-aos="fade-up"
  data-aos-delay={delay}
>
  <!-- Glow effect on hover -->
  <div
    class="absolute inset-0 rounded-lg opacity-0 group-hover:opacity-100 transition-opacity duration-500"
    style={`background: radial-gradient(circle at center, ${glowColor} 0%, transparent 70%); filter: blur(20px);`}
  ></div>

  <!-- Icon container (if icon slot is provided) -->
  {icon && (
    <div class="relative mb-4 flex justify-center">
      <div
        class="w-14 h-14 rounded-full flex items-center justify-center flex-shrink-0 transition-all duration-300 group-hover:scale-110 group-hover:rotate-12"
        style={`background: ${bgColor}; border: 2px solid ${borderColor}; box-shadow: 0 0 20px ${glowColor}, inset 0 0 20px ${glowColor};`}
      >
        <slot name="icon">
          <div class="relative z-10" style={`color: ${iconColor}; filter: drop-shadow(0 0 8px ${iconColor});`}>
            {icon}
          </div>
        </slot>
      </div>
    </div>
  )}

  <!-- Content -->
  <div class="relative">
    <slot name="before-title" />

    <h3
      class="font-orbitron text-lg font-bold mb-3 transition-all duration-300 group-hover:scale-105"
      style={`color: ${iconColor}; text-shadow: 0 0 10px ${glowColor};`}
    >
      {title}
    </h3>

    {description && (
      <p class="text-cyber-text/80 text-sm leading-relaxed">
        {description}
      </p>
    )}

    <slot name="content" />
  </div>

  <!-- Corner decorations -->
  <DecorativeCorners position={cornerPosition} color={iconColor} />

  <slot name="extra" />
</div>
