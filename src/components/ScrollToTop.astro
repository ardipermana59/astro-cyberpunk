---
// Scroll to top button component
---

<button
  id="scroll-to-top"
  class="group fixed opacity-0 invisible transition-all duration-500 hover:scale-110 cursor-pointer"
  style="bottom: 2rem; right: 2rem; z-index: 9999;"
  aria-label="Scroll to top"
>
  <!-- Outer Glow Ring -->
  <div class="absolute inset-0 rounded-full animate-pulse"
       style="background: radial-gradient(circle, rgba(0, 255, 240, 0.4) 0%, transparent 70%); filter: blur(8px);"></div>

  <!-- Button Container -->
  <div class="relative w-14 h-14 rounded-full flex items-center justify-center backdrop-blur-md transition-all duration-300 border-2 overflow-hidden"
       style="background: rgba(10, 15, 28, 0.8); border-color: rgba(0, 255, 240, 0.6); box-shadow: 0 0 20px rgba(0, 255, 240, 0.3), inset 0 0 20px rgba(0, 255, 240, 0.1);">

    <!-- Hover Background -->
    <div class="absolute inset-0 transition-transform duration-300 group-hover:scale-150"
         style="background: radial-gradient(circle, rgba(0, 255, 240, 0.6) 0%, transparent 70%);"></div>

    <!-- Scan Line -->
    <div class="scan-line-btn"></div>

    <!-- Arrow Icon -->
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="h-6 w-6 relative z-10 transition-all duration-300 group-hover:translate-y-[-2px]"
      style="color: var(--cyber-cyan); filter: drop-shadow(0 0 4px var(--cyber-cyan));"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2.5"
        d="M5 10l7-7m0 0l7 7m-7-7v18"
      ></path>
    </svg>

    <!-- Corner Decorations -->
    <div class="absolute top-0 left-0 w-3 h-3 border-t-2 border-l-2 transition-all duration-300 group-hover:w-4 group-hover:h-4"
         style="border-color: var(--cyber-magenta);"></div>
    <div class="absolute bottom-0 right-0 w-3 h-3 border-b-2 border-r-2 transition-all duration-300 group-hover:w-4 group-hover:h-4"
         style="border-color: var(--cyber-magenta);"></div>
  </div>

  <!-- Orbit Ring -->
  <div class="orbit-ring"></div>
</button>

<script>
  const scrollToTopBtn = document.getElementById('scroll-to-top');

  if (scrollToTopBtn) {
    // Show/hide button based on scroll position
    const toggleButton = () => {
      if (window.scrollY > 400) {
        scrollToTopBtn.classList.remove('invisible', 'opacity-0');
        scrollToTopBtn.classList.add('visible', 'opacity-100');
        scrollToTopBtn.style.pointerEvents = 'auto';
      } else {
        scrollToTopBtn.classList.add('invisible', 'opacity-0');
        scrollToTopBtn.classList.remove('visible', 'opacity-100');
        scrollToTopBtn.style.pointerEvents = 'none';
      }
    };

    // Initial check
    toggleButton();

    // Listen to scroll
    window.addEventListener('scroll', toggleButton, { passive: true });

    // Smooth scroll to top with animation
    scrollToTopBtn.addEventListener('click', () => {
      // Add click animation
      scrollToTopBtn.style.transform = 'scale(0.9)';
      setTimeout(() => {
        scrollToTopBtn.style.transform = '';
      }, 150);

      // Scroll to top
      window.scrollTo({
        top: 0,
        behavior: 'smooth'
      });
    });
  }
</script>

<style>
  /* Scan Line Animation */
  .scan-line-btn {
    position: absolute;
    top: -100%;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      to bottom,
      transparent 0%,
      rgba(0, 255, 240, 0.3) 50%,
      transparent 100%
    );
    animation: scan-btn 2s ease-in-out infinite;
  }

  @keyframes scan-btn {
    0% {
      top: -100%;
    }
    50% {
      top: 100%;
    }
    100% {
      top: 100%;
    }
  }

  /* Orbit Ring Animation */
  .orbit-ring {
    position: absolute;
    inset: -8px;
    border: 2px solid transparent;
    border-radius: 50%;
    border-top-color: var(--cyber-cyan);
    border-right-color: var(--cyber-magenta);
    animation: orbit 3s linear infinite;
    opacity: 0;
    transition: opacity 0.3s;
  }

  #scroll-to-top:hover .orbit-ring {
    opacity: 0.6;
  }

  @keyframes orbit {
    0% {
      transform: rotate(0deg);
    }
    100% {
      transform: rotate(360deg);
    }
  }

  /* Ensure button appears above everything */
  #scroll-to-top.visible {
    opacity: 1 !important;
    visibility: visible !important;
  }

  /* Glow effect on hover */
  #scroll-to-top:hover {
    filter: drop-shadow(0 0 15px rgba(0, 255, 240, 0.6));
  }

  /* Mobile responsiveness */
  @media (max-width: 768px) {
    #scroll-to-top {
      bottom: 1.5rem !important;
      right: 1.5rem !important;
    }

    #scroll-to-top > div:first-child {
      width: 3rem !important;
      height: 3rem !important;
    }

    #scroll-to-top svg {
      width: 1.25rem !important;
      height: 1.25rem !important;
    }
  }
</style>
