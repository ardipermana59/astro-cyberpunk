---
import { SITE_CONFIG, NAV_LINKS } from '../utils/config';

const currentYear = new Date().getFullYear();

// Check if there's at least one social media link or email
const hasSocialMedia = !!(
  (SITE_CONFIG.social.github && SITE_CONFIG.social.github !== "") ||
  (SITE_CONFIG.social.linkedin && SITE_CONFIG.social.linkedin !== "") ||
  (SITE_CONFIG.social.instagram && SITE_CONFIG.social.instagram !== "") ||
  (SITE_CONFIG.social.twitter && SITE_CONFIG.social.twitter !== "") ||
  (SITE_CONFIG.social.facebook && SITE_CONFIG.social.facebook !== "") ||
  (SITE_CONFIG.email && SITE_CONFIG.email !== "")
);
---

<footer class="relative overflow-hidden mt-20 border-t-2" style="background: linear-gradient(180deg, rgba(10, 15, 28, 0.9) 0%, rgba(26, 31, 46, 0.95) 100%); border-color: rgba(0, 255, 240, 0.3);">
  <!-- Animated Background Grid -->
  <div class="absolute inset-0 opacity-10">
    <div class="cyber-grid"></div>
  </div>

  <!-- Neon Line Animation -->
  <div class="neon-line"></div>

  <div class="container mx-auto px-4 py-16 relative">
    <!-- Top Section -->
    <div class={`grid grid-cols-1 gap-12 mb-12 ${hasSocialMedia ? 'md:grid-cols-4' : 'md:grid-cols-3'}`}>
      <!-- Brand Section -->
      <div class="md:col-span-2">
        <div class="mb-6">
          <a href="/" class="inline-block group">
            <h3 class="font-orbitron text-3xl font-bold mb-2 transition-all duration-300 group-hover:scale-105"
                style="background: linear-gradient(135deg, var(--cyber-cyan) 0%, var(--cyber-magenta) 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">
              {SITE_CONFIG.name}
            </h3>
          </a>
          <div class="h-1 w-20 rounded-full mb-4" style="background: linear-gradient(90deg, var(--cyber-cyan) 0%, var(--cyber-magenta) 100%);"></div>
        </div>
        <p class="text-cyber-text/80 text-sm leading-relaxed mb-6 max-w-md">
          {SITE_CONFIG.tagline}
        </p>
        <p class="text-cyber-text/60 text-xs font-rajdhani leading-relaxed">
          Specializing in crafting innovative digital solutions with cutting-edge technology, secure architecture, and modern development practices. Delivering high-performance web applications, blockchain solutions, and cybersecurity implementations that drive business success and technological advancement.
        </p>
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="font-orbitron text-sm font-bold mb-6 tracking-wider" style="color: var(--cyber-cyan);">
          NAVIGATION
        </h4>
        <ul class="space-y-3">
          {NAV_LINKS.map((link) => (
            <li>
              <a href={link.href}
                 class="text-cyber-text/70 text-sm transition-all duration-300 flex items-center group footer-nav-link relative">
                
                <span class="relative">
                  {link.label}
                  <!-- Underline effect -->
                  <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-gradient-to-r from-cyber-cyan to-cyber-magenta transition-all duration-300 group-hover:w-full neon-underline-footer"></span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Connect Section (Only show if social media exists) -->
      {hasSocialMedia && (
      <div>
        <h4 class="font-orbitron text-sm font-bold mb-6 tracking-wider" style="color: var(--cyber-cyan);">
          CONNECT
        </h4>
        <div class="flex flex-wrap gap-3">
          {SITE_CONFIG.social.github && (
            <a
              href={SITE_CONFIG.social.github}
              target="_blank"
              rel="noopener noreferrer"
              class="w-11 h-11 rounded-lg border transition-all duration-300 flex items-center justify-center group relative overflow-hidden social-icon-github"
              style="border-color: rgba(138, 43, 226, 0.4); background: rgba(138, 43, 226, 0.08);"
              aria-label="GitHub"
            >
              <div class="absolute inset-0 transition-all duration-300 group-hover:scale-150"
                   style="background: radial-gradient(circle, rgba(138, 43, 226, 0.3) 0%, transparent 70%);"></div>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-5 w-5 relative z-10 transition-all duration-300 group-hover:scale-110 group-hover:rotate-12"
                style="color: #8a2be2;"
                fill="currentColor"
                viewBox="0 0 24 24"
              >
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
              </svg>
            </a>
          )}
          {SITE_CONFIG.social.linkedin && (
            <a
              href={SITE_CONFIG.social.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="w-11 h-11 rounded-lg border transition-all duration-300 flex items-center justify-center group relative overflow-hidden social-icon-linkedin"
              style="border-color: rgba(0, 119, 181, 0.4); background: rgba(0, 119, 181, 0.08);"
              aria-label="LinkedIn"
            >
              <div class="absolute inset-0 transition-all duration-300 group-hover:scale-150"
                   style="background: radial-gradient(circle, rgba(0, 119, 181, 0.3) 0%, transparent 70%);"></div>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-5 w-5 relative z-10 transition-all duration-300 group-hover:scale-110 group-hover:-rotate-12"
                style="color: #0077b5;"
                fill="currentColor"
                viewBox="0 0 24 24"
              >
                <path d="M4.98 3.5c0 1.381-1.11 2.5-2.48 2.5s-2.48-1.119-2.48-2.5c0-1.38 1.11-2.5 2.48-2.5s2.48 1.12 2.48 2.5zm.02 4.5h-5v16h5v-16zm7.982 0h-4.968v16h4.969v-8.399c0-4.67 6.029-5.052 6.029 0v8.399h4.988v-10.131c0-7.88-8.922-7.593-11.018-3.714v-2.155z" />
              </svg>
            </a>
          )}
          {SITE_CONFIG.social.instagram && (
            <a
              href={SITE_CONFIG.social.instagram}
              target="_blank"
              rel="noopener noreferrer"
              class="w-11 h-11 rounded-lg border transition-all duration-300 flex items-center justify-center group relative overflow-hidden social-icon-instagram"
              style="border-color: rgba(225, 48, 108, 0.4); background: rgba(225, 48, 108, 0.08);"
              aria-label="Instagram"
            >
              <div class="absolute inset-0 transition-all duration-300 group-hover:scale-150"
                   style="background: radial-gradient(circle, rgba(225, 48, 108, 0.3) 0%, rgba(253, 29, 29, 0.2) 50%, rgba(245, 96, 64, 0.1) 100%);"></div>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-5 w-5 relative z-10 transition-all duration-300 group-hover:scale-110 group-hover:rotate-180"
                style="color: #e1306c;"
                fill="currentColor"
                viewBox="0 0 24 24"
              >
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
              </svg>
            </a>
          )}
          {SITE_CONFIG.social.twitter && (
            <a
              href={SITE_CONFIG.social.twitter}
              target="_blank"
              rel="noopener noreferrer"
              class="w-11 h-11 rounded-lg border transition-all duration-300 flex items-center justify-center group relative overflow-hidden social-icon-twitter"
              style="border-color: rgba(230, 230, 230, 0.4); background: rgba(230, 230, 230, 0.08);"
              aria-label="Twitter/X"
            >
              <div class="absolute inset-0 transition-all duration-300 group-hover:scale-150"
                   style="background: radial-gradient(circle, rgba(230, 230, 230, 0.3) 0%, transparent 70%);"></div>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-5 w-5 relative z-10 transition-all duration-300 group-hover:scale-110 group-hover:rotate-12"
                style="color: #e6e6e6;"
                fill="currentColor"
                viewBox="0 0 24 24"
              >
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
              </svg>
            </a>
          )}
          {SITE_CONFIG.social.facebook && (
            <a
              href={SITE_CONFIG.social.facebook}
              target="_blank"
              rel="noopener noreferrer"
              class="w-11 h-11 rounded-lg border transition-all duration-300 flex items-center justify-center group relative overflow-hidden social-icon-facebook"
              style="border-color: rgba(24, 119, 242, 0.4); background: rgba(24, 119, 242, 0.08);"
              aria-label="Facebook"
            >
              <div class="absolute inset-0 transition-all duration-300 group-hover:scale-150"
                   style="background: radial-gradient(circle, rgba(24, 119, 242, 0.3) 0%, transparent 70%);"></div>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-5 w-5 relative z-10 transition-all duration-300 group-hover:scale-110 group-hover:-rotate-12"
                style="color: #1877f2;"
                fill="currentColor"
                viewBox="0 0 24 24"
              >
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" />
              </svg>
            </a>
          )}
          {SITE_CONFIG.email && (
            <a
              href={`mailto:${SITE_CONFIG.email}`}
              class="w-11 h-11 rounded-lg border transition-all duration-300 flex items-center justify-center group relative overflow-hidden social-icon-email"
              style="border-color: rgba(255, 215, 0, 0.4); background: rgba(255, 215, 0, 0.08);"
              aria-label="Email"
            >
              <div class="absolute inset-0 transition-all duration-300 group-hover:scale-150"
                   style="background: radial-gradient(circle, rgba(255, 215, 0, 0.3) 0%, transparent 70%);"></div>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-5 w-5 relative z-10 transition-all duration-300 group-hover:scale-110 group-hover:rotate-12"
                style="color: #ffd700;"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </a>
          )}
        </div>
      </div>
      )}
    </div>

    <!-- Bottom Section -->
    <div class="border-t pt-8 mt-8" style="border-color: rgba(0, 255, 240, 0.2);">
      <div class="flex flex-col md:flex-row justify-between items-center gap-4">
        <div class="flex items-center gap-3">
          <div class="w-2 h-2 rounded-full animate-pulse" style="background: var(--cyber-cyan); box-shadow: 0 0 10px var(--cyber-cyan);"></div>
          <p class="text-cyber-text/60 text-sm font-rajdhani">
            &copy; {currentYear} <span class="text-cyber-cyan font-semibold">{SITE_CONFIG.name}</span>
          </p>
        </div>

        <div class="flex items-center gap-2 text-cyber-text/50 text-xs">
          <span>Built with</span>
          <a href="https://astro.build" target="_blank" rel="noopener noreferrer"
             class="text-cyber-cyan hover:text-cyber-magenta transition-colors font-semibold">
            Astro
          </a>
          <span>&</span>
          <a href="https://tailwindcss.com" target="_blank" rel="noopener noreferrer"
             class="text-cyber-cyan hover:text-cyber-magenta transition-colors font-semibold">
            TailwindCSS
          </a>
        </div>

        <div class="flex items-center gap-2 text-cyber-text/40 text-xs font-rajdhani">
          <div class="flex gap-1">
            <div class="w-1 h-4 animate-pulse" style="background: var(--cyber-cyan); animation-delay: 0s;"></div>
            <div class="w-1 h-4 animate-pulse" style="background: var(--cyber-magenta); animation-delay: 0.2s;"></div>
            <div class="w-1 h-4 animate-pulse" style="background: var(--cyber-cyan); animation-delay: 0.4s;"></div>
          </div>
          <span>All systems operational</span>
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  /* Cyber Grid Background */
  .cyber-grid {
    background-image:
      linear-gradient(rgba(0, 255, 240, 0.1) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0, 255, 240, 0.1) 1px, transparent 1px);
    background-size: 50px 50px;
    width: 100%;
    height: 100%;
    animation: grid-move 20s linear infinite;
  }

  @keyframes grid-move {
    0% {
      transform: translateY(0);
    }
    100% {
      transform: translateY(50px);
    }
  }

  /* Neon Line Animation */
  .neon-line {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background: linear-gradient(90deg,
      transparent 0%,
      var(--cyber-cyan) 50%,
      transparent 100%
    );
    animation: neon-sweep 3s ease-in-out infinite;
    opacity: 0.6;
  }

  @keyframes neon-sweep {
    0%, 100% {
      transform: translateX(-100%);
    }
    50% {
      transform: translateX(100%);
    }
  }

  /* Footer Navigation Link Hover Effects */
  .footer-nav-link:hover {
    color: var(--cyber-cyan);
    text-shadow:
      0 0 8px rgba(0, 255, 240, 0.6),
      0 0 15px rgba(0, 255, 240, 0.4);
    transform: translateX(4px);
  }

  /* Neon glow for small line indicator */
  .neon-line-small {
    box-shadow:
      0 0 5px rgba(0, 255, 240, 0.8),
      0 0 10px rgba(0, 255, 240, 0.6);
  }

  /* Neon underline for footer links */
  .neon-underline-footer {
    box-shadow:
      0 0 5px rgba(0, 255, 240, 0.8),
      0 0 10px rgba(0, 255, 240, 0.6),
      0 0 15px rgba(255, 0, 255, 0.4);
  }

  .footer-nav-link:hover .neon-underline-footer {
    animation: neonPulseFooter 1.5s ease-in-out infinite;
  }

  @keyframes neonPulseFooter {
    0%, 100% {
      box-shadow:
        0 0 5px rgba(0, 255, 240, 0.8),
        0 0 10px rgba(0, 255, 240, 0.6),
        0 0 15px rgba(255, 0, 255, 0.4);
    }
    50% {
      box-shadow:
        0 0 10px rgba(0, 255, 240, 1),
        0 0 20px rgba(0, 255, 240, 0.8),
        0 0 30px rgba(255, 0, 255, 0.6);
    }
  }

  /* Social Media Icon Unique Hover Effects */
  .social-icon-github:hover {
    box-shadow:
      0 0 20px rgba(138, 43, 226, 0.6),
      0 0 40px rgba(138, 43, 226, 0.4);
    transform: translateY(-4px);
  }

  .social-icon-linkedin:hover {
    box-shadow:
      0 0 20px rgba(0, 119, 181, 0.6),
      0 0 40px rgba(0, 119, 181, 0.4);
    transform: translateY(-4px);
  }

  .social-icon-instagram:hover {
    box-shadow:
      0 0 20px rgba(225, 48, 108, 0.6),
      0 0 40px rgba(253, 29, 29, 0.4),
      0 0 60px rgba(245, 96, 64, 0.2);
    transform: translateY(-4px) scale(1.05);
  }

  .social-icon-twitter:hover {
    box-shadow:
      0 0 20px rgba(230, 230, 230, 0.6),
      0 0 40px rgba(230, 230, 230, 0.4);
    transform: translateY(-4px);
  }

  .social-icon-facebook:hover {
    box-shadow:
      0 0 20px rgba(24, 119, 242, 0.6),
      0 0 40px rgba(24, 119, 242, 0.4);
    transform: translateY(-4px);
  }

  .social-icon-email:hover {
    box-shadow:
      0 0 20px rgba(255, 215, 0, 0.6),
      0 0 40px rgba(255, 215, 0, 0.4);
    transform: translateY(-4px) rotate(5deg);
  }

  /* Pulse Animation for Status Indicators */
  @keyframes pulse {
    0%, 100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.5;
      transform: scale(0.8);
    }
  }
</style>
