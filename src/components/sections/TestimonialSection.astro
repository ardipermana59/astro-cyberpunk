---
import { TESTIMONIALS } from '../../utils/config';
---

<section id="testimonials" class="relative py-10 overflow-hidden">
  <!-- Background Elements -->
  <div class="absolute inset-0 opacity-5">
    <div class="cyber-grid-bg"></div>
  </div>

  <div class="container mx-auto px-4 relative z-10">
    <!-- Section Header -->
    <div class="text-center mb-16" data-aos="fade-up">
      <h2 class="font-orbitron text-4xl md:text-5xl font-bold mb-4">
        <span class="neon-text-cyan">Client</span>
        <span class="text-cyber-text">Testimonials</span>
      </h2>
      <div class="h-1 w-24 mx-auto mb-6 rounded-full" style="background: linear-gradient(90deg, var(--cyber-cyan) 0%, var(--cyber-magenta) 100%);"></div>
      <p class="text-cyber-text/80 text-lg max-w-2xl mx-auto">
        What clients say about working with me
      </p>
    </div>

    <!-- Testimonials Carousel -->
    <div class="max-w-6xl mx-auto relative">
      <!-- Carousel Container -->
      <div class="testimonials-carousel-wrapper overflow-hidden" data-aos="fade-up">
        <div id="testimonials-carousel" class="testimonials-carousel flex transition-transform duration-500 ease-out">
          {TESTIMONIALS.map((testimonial, index) => (
            <div class="testimonial-slide w-full md:w-1/2 flex-shrink-0 px-3">
              <div class="testimonial-card group relative h-full">
                <!-- Glow Effect -->
                <div class="absolute inset-0 rounded-lg opacity-0 group-hover:opacity-100 transition-opacity duration-500"
                     style="background: radial-gradient(circle at center, rgba(0, 255, 240, 0.1) 0%, transparent 70%); filter: blur(20px);"></div>

                <!-- Card Content -->
                <div class="relative h-full rounded-lg border-2 p-6 backdrop-blur-sm transition-all duration-300 group-hover:border-cyan-400"
                     style="background: rgba(10, 15, 28, 0.7); border-color: rgba(0, 255, 240, 0.3);">

                  <!-- Quote Icon -->
                  <div class="absolute top-4 right-4 opacity-10 transition-opacity group-hover:opacity-20">
                    <svg class="w-12 h-12" fill="currentColor" viewBox="0 0 24 24" style="color: var(--cyber-cyan);">
                      <path d="M6 17h3l2-4V7H5v6h3zm8 0h3l2-4V7h-6v6h3z"/>
                    </svg>
                  </div>

                  <!-- Rating Stars -->
                  <div class="flex gap-1 mb-4">
                    {Array.from({ length: testimonial.rating }).map(() => (
                      <svg class="w-5 h-5 transition-all duration-300 group-hover:scale-110" viewBox="0 0 20 20" fill="currentColor" style="color: var(--cyber-cyan);">
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                      </svg>
                    ))}
                  </div>

                  <!-- Testimonial Text -->
                  <blockquote class="text-cyber-text/90 text-sm md:text-base leading-relaxed mb-6 font-rajdhani">
                    "{testimonial.text}"
                  </blockquote>

                  <!-- Client Info -->
                  <div class="flex items-center gap-4 mt-auto pt-4 border-t" style="border-color: rgba(0, 255, 240, 0.2);">
                    <!-- Avatar -->
                    <div class="relative">
                      <div class="absolute inset-0 rounded-full animate-pulse"
                           style="background: radial-gradient(circle, rgba(0, 255, 240, 0.4) 0%, transparent 70%); filter: blur(4px);"></div>
                      <div class="relative w-12 h-12 rounded-full border-2 overflow-hidden"
                           style="border-color: var(--cyber-cyan);">
                        <img src={testimonial.avatar} alt={testimonial.name} class="w-full h-full object-cover" loading="lazy" decoding="async" />
                      </div>
                    </div>

                    <!-- Name & Role -->
                    <div>
                      <h4 class="font-orbitron font-semibold text-cyber-cyan text-sm md:text-base">
                        {testimonial.name}
                      </h4>
                      <p class="text-cyber-text/60 text-xs md:text-sm">
                        {testimonial.role}
                      </p>
                    </div>
                  </div>

                  <!-- Corner Decorations -->
                  <div class="absolute top-0 left-0 w-4 h-4 border-t-2 border-l-2 transition-all duration-300 group-hover:w-6 group-hover:h-6"
                       style="border-color: var(--cyber-magenta);"></div>
                  <div class="absolute bottom-0 right-0 w-4 h-4 border-b-2 border-r-2 transition-all duration-300 group-hover:w-6 group-hover:h-6"
                       style="border-color: var(--cyber-magenta);"></div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Navigation Buttons -->
      <button
        id="prev-testimonial"
        class="absolute left-0 top-1/2 -translate-y-1/2 -translate-x-4 md:-translate-x-12 w-12 h-12 rounded-full border-2 flex items-center justify-center transition-all duration-300 hover:scale-110 group z-10 cursor-pointer"
        style="background: rgba(10, 15, 28, 0.9); border-color: var(--cyber-cyan); box-shadow: 0 0 20px rgba(0, 255, 240, 0.3);"
        aria-label="Previous testimonial"
      >
        <div class="absolute inset-0 rounded-full opacity-0 group-hover:opacity-100 transition-opacity"
             style="background: radial-gradient(circle, rgba(0, 255, 240, 0.3) 0%, transparent 70%);"></div>
        <svg class="w-6 h-6 relative z-10" style="color: var(--cyber-cyan);" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
      </button>

      <button
        id="next-testimonial"
        class="absolute right-0 top-1/2 -translate-y-1/2 translate-x-4 md:translate-x-12 w-12 h-12 rounded-full border-2 flex items-center justify-center transition-all duration-300 hover:scale-110 group z-10 cursor-pointer"
        style="background: rgba(10, 15, 28, 0.9); border-color: var(--cyber-magenta); box-shadow: 0 0 20px rgba(255, 0, 255, 0.3);"
        aria-label="Next testimonial"
      >
        <div class="absolute inset-0 rounded-full opacity-0 group-hover:opacity-100 transition-opacity"
             style="background: radial-gradient(circle, rgba(255, 0, 255, 0.3) 0%, transparent 70%);"></div>
        <svg class="w-6 h-6 relative z-10" style="color: var(--cyber-magenta);" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </button>

      <!-- Pagination Dots -->
      <div class="flex justify-center gap-3 mt-8" id="testimonial-dots">
        {TESTIMONIALS.map((_, index) => (
          <button
            class="testimonial-dot w-3 h-3 rounded-full transition-all duration-300 hover:scale-125 cursor-pointer"
            style="background: rgba(0, 255, 240, 0.3);"
            data-index={index}
            aria-label={`Go to testimonial ${index + 1}`}
          ></button>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  let currentIndex = 0;
  const carousel = document.getElementById('testimonials-carousel');
  const prevBtn = document.getElementById('prev-testimonial');
  const nextBtn = document.getElementById('next-testimonial');
  const dots = document.querySelectorAll('.testimonial-dot');
  const totalSlides = dots.length;

  // Mouse drag variables
  let isDragging = false;
  let startPos = 0;
  let currentTranslate = 0;
  let prevTranslate = 0;
  let animationID: number;

  // Calculate slides per view based on screen size
  function getSlidesPerView() {
    return window.innerWidth >= 768 ? 2 : 1;
  }

  function updateCarousel(smooth = true) {
    if (!carousel) return;

    const slidesPerView = getSlidesPerView();

    // Infinite loop: wrap around
    if (currentIndex < 0) {
      currentIndex = totalSlides - 1;
    } else if (currentIndex >= totalSlides) {
      currentIndex = 0;
    }

    const slideWidth = 100 / slidesPerView;
    const offset = -(currentIndex * slideWidth);

    if (smooth) {
      carousel.style.transition = 'transform 0.5s ease-out';
    } else {
      carousel.style.transition = 'none';
    }

    carousel.style.transform = `translateX(${offset}%)`;

    // Update dots (show active based on current position)
    const activeIndex = currentIndex % totalSlides;
    dots.forEach((dot, index) => {
      if (index === activeIndex || (slidesPerView === 2 && index === (activeIndex + 1) % totalSlides)) {
        dot.style.background = 'linear-gradient(135deg, var(--cyber-cyan), var(--cyber-magenta))';
        dot.style.width = '2rem';
        dot.style.boxShadow = '0 0 10px var(--cyber-cyan)';
      } else {
        dot.style.background = 'rgba(0, 255, 240, 0.3)';
        dot.style.width = '0.75rem';
        dot.style.boxShadow = 'none';
      }
    });

    // Buttons always enabled for infinite loop
    if (prevBtn && nextBtn) {
      prevBtn.style.opacity = '1';
      prevBtn.style.pointerEvents = 'auto';
      nextBtn.style.opacity = '1';
      nextBtn.style.pointerEvents = 'auto';
    }
  }

  function nextSlide() {
    currentIndex++;
    updateCarousel();
  }

  function prevSlide() {
    currentIndex--;
    updateCarousel();
  }

  function goToSlide(index: number) {
    currentIndex = index;
    updateCarousel();
  }

  // Event listeners
  if (prevBtn) prevBtn.addEventListener('click', prevSlide);
  if (nextBtn) nextBtn.addEventListener('click', nextSlide);

  dots.forEach((dot) => {
    dot.addEventListener('click', (e) => {
      const index = parseInt((e.target as HTMLElement).dataset.index || '0');
      goToSlide(index);
    });
  });

  // Keyboard navigation
  document.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') prevSlide();
    if (e.key === 'ArrowRight') nextSlide();
  });

  // Mouse Drag functionality
  function getPositionX(event: MouseEvent | TouchEvent): number {
    return event.type.includes('mouse')
      ? (event as MouseEvent).pageX
      : (event as TouchEvent).touches[0].clientX;
  }

  function animation() {
    if (carousel) {
      carousel.style.transform = `translateX(${currentTranslate}px)`;
      if (isDragging) requestAnimationFrame(animation);
    }
  }

  function setPositionByIndex() {
    const slidesPerView = getSlidesPerView();
    if (!carousel) return;

    const slideWidth = carousel.offsetWidth / slidesPerView;
    currentTranslate = currentIndex * -slideWidth;
    prevTranslate = currentTranslate;
    updateCarousel();
  }

  function dragStart(event: MouseEvent | TouchEvent) {
    if (event.type === 'mousedown') {
      event.preventDefault();
    }

    isDragging = true;
    startPos = getPositionX(event);
    animationID = requestAnimationFrame(animation);

    if (carousel) {
      carousel.style.cursor = 'grabbing';
      carousel.style.transition = 'none';
    }
  }

  function dragMove(event: MouseEvent | TouchEvent) {
    if (!isDragging) return;

    const currentPosition = getPositionX(event);
    const diff = currentPosition - startPos;

    if (!carousel) return;
    const slideWidth = carousel.offsetWidth / getSlidesPerView();
    currentTranslate = prevTranslate + diff;

    // Apply resistance at boundaries for infinite feel
    const maxTranslate = 0;
    const minTranslate = -(totalSlides - getSlidesPerView()) * slideWidth;

    if (currentTranslate > maxTranslate) {
      currentTranslate = maxTranslate + (currentTranslate - maxTranslate) * 0.3;
    } else if (currentTranslate < minTranslate) {
      currentTranslate = minTranslate + (currentTranslate - minTranslate) * 0.3;
    }
  }

  function dragEnd() {
    if (!isDragging) return;

    isDragging = false;
    cancelAnimationFrame(animationID);

    if (!carousel) return;

    const slideWidth = carousel.offsetWidth / getSlidesPerView();
    const movedBy = currentTranslate - prevTranslate;

    // Determine if we should go to next/prev slide
    if (movedBy < -50) {
      currentIndex++;
    } else if (movedBy > 50) {
      currentIndex--;
    }

    // Wrap around for infinite loop
    if (currentIndex < 0) {
      currentIndex = totalSlides - 1;
    } else if (currentIndex >= totalSlides) {
      currentIndex = 0;
    }

    setPositionByIndex();
    carousel.style.cursor = 'grab';
  }

  // Mouse events
  if (carousel) {
    carousel.addEventListener('mousedown', dragStart, { passive: false });
    carousel.addEventListener('mousemove', dragMove, { passive: true });
    carousel.addEventListener('mouseup', dragEnd, { passive: true });
    carousel.addEventListener('mouseleave', dragEnd, { passive: true });

    // Touch events
    carousel.addEventListener('touchstart', dragStart, { passive: false });
    carousel.addEventListener('touchmove', dragMove, { passive: false });
    carousel.addEventListener('touchend', dragEnd, { passive: true });

    // Prevent context menu on long press
    carousel.addEventListener('contextmenu', (e) => e.preventDefault());

    // Set cursor
    carousel.style.cursor = 'grab';
  }

  // Auto-play
  let autoplayInterval: number | null = null;

  function startAutoplay() {
    autoplayInterval = window.setInterval(() => {
      nextSlide();
    }, 5000);
  }

  function stopAutoplay() {
    if (autoplayInterval) {
      clearInterval(autoplayInterval);
      autoplayInterval = null;
    }
  }

  // Start autoplay and pause on hover/interaction
  startAutoplay();

  const section = document.getElementById('testimonials');
  if (section) {
    section.addEventListener('mouseenter', stopAutoplay);
    section.addEventListener('mouseleave', startAutoplay);
  }

  // Stop autoplay when user interacts
  if (carousel) {
    carousel.addEventListener('mousedown', stopAutoplay);
    carousel.addEventListener('touchstart', stopAutoplay);
  }

  // Update on window resize
  window.addEventListener('resize', () => {
    updateCarousel(false);
  });

  // Initial update
  updateCarousel();
</script>

<style>
  /* Cyber Grid Background */
  .cyber-grid-bg {
    background-image:
      linear-gradient(rgba(0, 255, 240, 0.1) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0, 255, 240, 0.1) 1px, transparent 1px);
    background-size: 40px 40px;
    width: 100%;
    height: 100%;
    animation: grid-scroll 20s linear infinite;
  }

  @keyframes grid-scroll {
    0% {
      transform: translateY(0);
    }
    100% {
      transform: translateY(40px);
    }
  }

  /* Star Animation on Hover */
  .testimonial-card:hover svg[viewBox="0 0 20 20"] {
    filter: drop-shadow(0 0 4px var(--cyber-cyan));
  }

  /* Carousel Wrapper */
  .testimonials-carousel-wrapper {
    position: relative;
  }

  /* Smooth transitions */
  .testimonials-carousel {
    will-change: transform;
    user-select: none;
    -webkit-user-select: none;
    -moz-user-select: none;
    -ms-user-select: none;
  }

  /* Prevent text selection during drag */
  .testimonials-carousel * {
    user-select: none;
    -webkit-user-select: none;
    -moz-user-select: none;
    -ms-user-select: none;
  }

  /* Navigation buttons hover effect */
  button:hover svg {
    filter: drop-shadow(0 0 8px currentColor);
  }
</style>
