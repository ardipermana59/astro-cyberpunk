---
import SectionDivider from '../SectionDivider.astro';
import SectionTitle from '../SectionTitle.astro';
import NeonButton from '../NeonButton.astro';
import GlassCard from '../GlassCard.astro';
import ContactInfoCard from '../ContactInfoCard.astro';
import { SITE_CONFIG } from '../../utils/config';
---

<section id="contact" class="py-10">
  <div class="container mx-auto px-4">
    <SectionDivider />

    <!-- Section Title -->
    <SectionTitle
      title="Get In Touch"
      subtitle="Have a project in mind? Let's work together to create something amazing"
    />

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 max-w-6xl mx-auto">
      <!-- Contact Form -->
      <div data-aos="fade-right">
        <GlassCard class="h-full">
          <form id="contact-form" class="space-y-6">
            <div>
              <label for="name" class="block text-cyber-text font-rajdhani mb-2">
                Name *
              </label>
              <input
                type="text"
                id="name"
                name="name"
                required
                class="w-full px-4 py-3 bg-cyber-gray/50 border-2 border-cyber-cyan/30 rounded-lg text-cyber-text focus:border-cyber-cyan focus:outline-none transition-colors"
                placeholder="Your name"
              />
            </div>

            <div>
              <label for="email" class="block text-cyber-text font-rajdhana mb-2">
                Email *
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full px-4 py-3 bg-cyber-gray/50 border-2 border-cyber-cyan/30 rounded-lg text-cyber-text focus:border-cyber-cyan focus:outline-none transition-colors"
                placeholder="your.email@example.com"
              />
            </div>

            <div>
              <label for="subject" class="block text-cyber-text font-rajdhani mb-2">
                Subject
              </label>
              <input
                type="text"
                id="subject"
                name="subject"
                class="w-full px-4 py-3 bg-cyber-gray/50 border-2 border-cyber-cyan/30 rounded-lg text-cyber-text focus:border-cyber-cyan focus:outline-none transition-colors"
                placeholder="Project inquiry"
              />
            </div>

            <div>
              <label for="message" class="block text-cyber-text font-rajdhani mb-2">
                Message *
              </label>
              <textarea
                id="message"
                name="message"
                required
                rows="5"
                class="w-full px-4 py-3 bg-cyber-gray/50 border-2 border-cyber-cyan/30 rounded-lg text-cyber-text focus:border-cyber-cyan focus:outline-none transition-colors resize-none"
                placeholder="Tell me about your project..."
              ></textarea>
            </div>

            <NeonButton type="submit" variant="cyan" size="lg" class="w-full">
              Send Message
            </NeonButton>

            <div id="form-status" class="text-center hidden"></div>
          </form>
        </GlassCard>
      </div>

      <!-- Contact Info -->
      <div class="space-y-6" data-aos="fade-left">
        <!-- Email Card -->
        <ContactInfoCard
          title="Email"
          iconColor="#00fff0"
          bgColor="rgba(0, 255, 240, 0.1)"
          borderColor="rgba(0, 255, 240, 0.5)"
          glowColor="rgba(0, 255, 240, 0.4)"
          cornerPosition="top-right"
        >
          <svg slot="icon" xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 relative z-10" style="color: #00fff0; filter: drop-shadow(0 0 8px #00fff0);" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          <a slot="content" href={`mailto:${SITE_CONFIG.email}`} class="text-cyber-text/80 hover:text-cyan-300 transition-colors">
            {SITE_CONFIG.email}
          </a>
        </ContactInfoCard>

        <!-- Location Card -->
        <ContactInfoCard
          title="Location"
          iconColor="#ff00ff"
          bgColor="rgba(255, 0, 255, 0.1)"
          borderColor="rgba(255, 0, 255, 0.5)"
          glowColor="rgba(255, 0, 255, 0.4)"
          cornerPosition="bottom-left"
        >
          <svg slot="icon" xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 relative z-10" style="color: #ff00ff; filter: drop-shadow(0 0 8px #ff00ff);" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          <p slot="content" class="text-cyber-text/80">
            {SITE_CONFIG.location}
          </p>
        </ContactInfoCard>

        <!-- Social Media Card -->
        <ContactInfoCard
          title="Social Media"
          iconColor="#00ff7f"
          bgColor="rgba(0, 255, 127, 0.1)"
          borderColor="rgba(0, 255, 127, 0.5)"
          glowColor="rgba(0, 255, 127, 0.4)"
          cornerPosition="top-left"
        >
          <svg slot="icon" xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 relative z-10" style="color: #00ff7f; filter: drop-shadow(0 0 8px #00ff7f);" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
          </svg>
          <div slot="content" class="flex flex-wrap gap-3">
            {SITE_CONFIG.social.github && (
              <a
                href={SITE_CONFIG.social.github}
                target="_blank"
                rel="noopener noreferrer"
                class="text-cyber-text/80 hover:text-green-300 transition-colors text-sm"
              >
                GitHub
              </a>
            )}
            {SITE_CONFIG.social.linkedin && (
              <a
                href={SITE_CONFIG.social.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                class="text-cyber-text/80 hover:text-green-300 transition-colors text-sm"
              >
                LinkedIn
              </a>
            )}
            {SITE_CONFIG.social.instagram && (
              <a
                href={SITE_CONFIG.social.instagram}
                target="_blank"
                rel="noopener noreferrer"
                class="text-cyber-text/80 hover:text-green-300 transition-colors text-sm"
              >
                Instagram
              </a>
            )}
          </div>
        </ContactInfoCard>

        <!-- Call to Action -->
        <div class="relative mt-8 p-8 rounded-lg overflow-hidden group transition-all duration-300 hover:scale-105"
             style="background: linear-gradient(135deg, rgba(0, 255, 240, 0.15), rgba(255, 0, 255, 0.15)); border: 2px solid rgba(255, 215, 0, 0.5);">
          <!-- Animated background -->
          <div class="absolute inset-0 opacity-20">
            <div class="absolute inset-0 animate-pulse" style="background: linear-gradient(45deg, transparent, rgba(255, 215, 0, 0.3), transparent);"></div>
          </div>

          <p class="text-center font-orbitron text-lg font-bold relative z-10" style="color: #ffd700; text-shadow: 0 0 20px rgba(255, 215, 0, 0.6);">
            "Let's build something extraordinary together"
          </p>

          <!-- Sparkle decorations -->
          <div class="absolute top-2 right-2 w-2 h-2 rounded-full animate-pulse" style="background: #ffd700; box-shadow: 0 0 10px #ffd700;"></div>
          <div class="absolute bottom-2 left-2 w-2 h-2 rounded-full animate-pulse" style="background: #00fff0; box-shadow: 0 0 10px #00fff0; animation-delay: 0.5s;"></div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const formStatus = document.getElementById('form-status') as HTMLElement;

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const formData = new FormData(form);
      const data = Object.fromEntries(formData);

      // Show loading state
      formStatus.classList.remove('hidden');
      formStatus.className = 'text-center text-cyber-cyan';
      formStatus.textContent = 'Sending message...';

      // Simulate form submission (replace with actual API call)
      // For production, integrate with EmailJS, Netlify Forms, or your backend API
      try {
        // Example: await fetch('/api/contact', { method: 'POST', body: JSON.stringify(data) });

        // Simulate API delay
        await new Promise(resolve => setTimeout(resolve, 1500));

        // Success
        formStatus.className = 'text-center text-green-400';
        formStatus.textContent = 'Message sent successfully! I\'ll get back to you soon.';
        form.reset();

        // Hide success message after 5 seconds
        setTimeout(() => {
          formStatus.classList.add('hidden');
        }, 5000);
      } catch (error) {
        // Error
        formStatus.className = 'text-center text-red-400';
        formStatus.textContent = 'Failed to send message. Please try again or email me directly.';
      }
    });
  }
</script>

<style>
  input:focus,
  textarea:focus {
    box-shadow: 0 0 20px rgba(0, 255, 240, 0.3);
  }

  input::placeholder,
  textarea::placeholder {
    color: rgba(224, 224, 224, 0.3);
  }
</style>
