---
interface Props {
  color?: string;
  blur?: string;
  className?: string;
}

const {
  color = 'rgba(0, 255, 240, 0.4)',
  blur = '20px',
  className = ''
} = Astro.props;
---

<div
  class={`absolute inset-0 rounded-lg opacity-0 group-hover:opacity-100 transition-opacity duration-500 ${className}`}
  style={`background: radial-gradient(circle at center, ${color} 0%, transparent 70%); filter: blur(${blur});`}
></div>
